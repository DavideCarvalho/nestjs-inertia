{
  "name": "@dudousxd/nestjs-inertia-vite",
  "version": "1.4.2",
  "description": "Vite integration for @dudousxd/nestjs-inertia — dev middleware, prod static serving, plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-inertia.git",
    "directory": "packages/vite"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/plugin.d.ts",
      "import": "./dist/plugin/plugin.js",
      "require": "./dist/plugin/plugin.cjs"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-inertia": ">=1.4.2",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "vite": ">=5.0.0",
    "@vitejs/plugin-react": ">=4.0.0",
    "@vitejs/plugin-vue": ">=5.0.0",
    "@sveltejs/vite-plugin-svelte": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": {
      "optional": true
    },
    "@vitejs/plugin-vue": {
      "optional": true
    },
    "@sveltejs/vite-plugin-svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-inertia": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "express": "^4.19.2",
    "typescript": "^5.4.0",
    "vite": "^6.4.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
