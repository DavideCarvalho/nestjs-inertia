{
  "name": "@dudousxd/nestjs-inertia-codegen-extension",
  "version": "0.3.0",
  "description": "nestjs-codegen extension for @dudousxd/nestjs-inertia — adds the Inertia navigate() helper to the generated api.ts, plus opt-in shared.ts and page-excludes.ts emission.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-inertia.git",
    "directory": "packages/codegen-extension"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/inertia",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-inertia/issues"
  },
  "keywords": ["nestjs", "inertia", "codegen", "extension"],
  "license": "MIT",
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist/"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-codegen": ">=0.2.1",
    "@inertiajs/react": ">=1.0.0"
  },
  "dependencies": {
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-codegen": "0.25.2",
    "@types/node": "20.19.41",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
