{
  "name": "@dudousxd/nestjs-inertia-cli",
  "version": "0.2.0",
  "description": "Onboarding CLI for @dudousxd/nestjs-inertia — scaffold a project with `init`, diagnose setup pitfalls with `doctor`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-inertia.git",
    "directory": "packages/cli"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/inertia",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-inertia/issues"
  },
  "keywords": ["nestjs", "inertia", "cli"],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nestjs-inertia": "dist/bin.js"
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "prepack": "node ../../scripts/check-package-exports.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}
