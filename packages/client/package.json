{
  "name": "@dudousxd/nestjs-inertia-client",
  "version": "1.6.0",
  "description": "Tuyau-style typed HTTP client for @dudousxd/nestjs-inertia, built on TanStack Query v5 core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-inertia.git",
    "directory": "packages/client"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ssr": {
      "types": "./dist/ssr/hydrate.d.ts",
      "import": "./dist/ssr/hydrate.js",
      "require": "./dist/ssr/hydrate.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js",
      "require": "./dist/svelte/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/svelte/Link.svelte",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && cp src/svelte/Link.svelte dist/svelte/Link.svelte",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-inertia": "workspace:*",
    "@inertiajs/react": "^2.0.0 || ^3.0.0",
    "@inertiajs/vue3": "^2.0.0 || ^3.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@tanstack/query-core": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.4.0",
    "@inertiajs/svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@inertiajs/vue3": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@inertiajs/svelte": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-inertia": "workspace:*",
    "@inertiajs/react": "^3.0.0",
    "@nestjs/common": "^11.0.0",
    "@tanstack/query-core": "^5.51.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "typescript": "^5.4.0",
    "@inertiajs/vue3": "^3.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vue": "^3.5.0",
    "@inertiajs/svelte": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.3.1",
    "svelte": "^5.55.9",
    "vitest": "^3.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
