      "optional": true
    },
    "handlebars": {
      "optional": true
    },
    "liquidjs": {
      "optional": true
    },
    "pug": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fastify/cookie": "^9.3.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/pug": "^2.0.10",
    "@types/supertest": "^6.0.2",
