{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": ".tsbuildinfo",
    "types": ["node", "reflect-metadata", "vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "inertia/**/*.ts",
    ".nestjs-inertia/**/*.ts",
    "nestjs-inertia.d.ts",
    "vite.config.ts",
    "nestjs-inertia.config.ts"
  ],
  "exclude": ["dist/**", "node_modules/**"]
}
