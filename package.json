{
  "name": "nestjs-inertia",
  "version": "0.9.0-alpha.0",
  "private": true,
  "description": "Inertia.js adapter for NestJS \u2014 TypeScript-first, multi-app, Tuyau-style typed client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-inertia.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && sh scripts/sync-versions.sh && biome check --write .",
    "release": "pnpm -r --filter './packages/*' build && changeset publish"
  },
  "pnpm": {
    "overrides": {
      "@vue/server-renderer": ">=3.5.42",
      "axios": ">=1.18.0",
      "body-parser@2": "^2.4.0",
      "brace-expansion": ">=5.0.10",
      "browserslist": ">=4.28.7",
      "compression": ">=1.8.2",
      "esbuild": ">=0.28.1",
      "fast-uri@3": "^3.1.7",
      "fast-uri@4": "^4.1.4",
      "js-yaml@4": "^4.3.2",
      "multer": ">=2.5.0",
      "nanoid@3": "3.3.19",
      "next": ">=16.3.6",
      "postcss": ">=8.5.23",
      "proxy-addr": ">=2.0.8",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2",
      "undici@7": "^7.29.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@dudousxd/nestjs-filter-client": "1.33.0",
    "@swc/core": "^1.16.2",
    "@vitest/coverage-v8": "^4.1.8",
    "tsup": "^8.5.1",
    "turbo": "^2.11.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
