{
  "name": "nestjs-inertia",
  "version": "0.9.0-alpha.0",
  "private": true,
  "description": "Inertia.js adapter for NestJS — TypeScript-first, multi-app, Tuyau-style typed client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-inertia.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && sh scripts/sync-versions.sh",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.27.0",
    "@swc/core": "^1.15.40",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.5.1",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
