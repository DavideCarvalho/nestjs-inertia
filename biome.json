{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "ignore": [
      "dist/**",
      "node_modules/**",
      ".turbo/**",
      "coverage/**",
      "**/*.svelte",
      "**/.nestjs-inertia/**",
      "website/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" },
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyInterface": "off"
      }
    }
  },
  "overrides": [
    {
      "include": [
        "**/test/**",
        "packages/codegen/src/discovery/probe.ts",
        "examples/express-react/inertia/app.tsx",
        "examples/fastify-vue/inertia/app.ts",
        "examples/express-svelte/inertia/app.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    }
  ]
}
